# The VPS's :443 by first bytes and TLS name (sni-443.py) — replaces a hand-made dispatcher.
# Same rules as before (STUN → coturn, the trunk's name → the ap with PROXY v1, the rest → the
# website) + ICE over TCP → the ap's livekit-ice forward. Config: /etc/trunk-ap/sni-443.conf.
[Unit]
Description=:443 by first bytes and TLS name — coturn, the trunk access point, the website
After=network-online.target
Wants=network-online.target
Conflicts=turn-dispatcher.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/yggdrasil-trunk/sni-443.py -c /etc/trunk-ap/sni-443.conf
# v2: `systemctl reload` = SIGHUP = the config read again, live connections kept (sni-443.py docstring);
# check a config first: python3 /usr/local/lib/yggdrasil-trunk/sni-443.py -c <file> --check
ExecReload=/bin/kill -HUP $MAINPID
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
