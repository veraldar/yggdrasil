{
  "_doc": [
    "The trunk-v1 ladder (spec rev 3 §9) as data. Read by sim/v1-ladder.sh; the required id list is hard-coded",
    "again in trunk/deploy/gate-check.sh, so a registry that drops a gate yields a refused gate file.",
    "gate: id, title, status (as-is | port | new | as-is+new), timing (true = needs 5 green runs),",
    "  steps[]: {cmd (bash -c, cwd = the throwaway worktree + cwd), cwd, timeout (s), env, counts (parser names),",
    "            ports (TCP ports that must be free), units (exact transient unit names: must be idle before,",
    "            are stopped after), containers (exact docker names: must be absent before, removed after),",
    "            requires (host paths/commands that must exist, else ERROR), exists (worktree paths, else MISSING)}",
    "  pending: a reason the v1 command is not written yet -> MISSING (never run, never skipped silently)",
    "  v09: the v0.9 steps a 'port' gate replaces; run only with --v09 (baseline), always into a .partial.json",
    "  locks: extra flock files under ~/.cache/trunk-v1 (twin = the acceptance twin :4250/:4251/:8250)",
    "  needs: builds the steps need beyond the default three (brain, net, app): net-root, old-brain",
    "Templates in cmd/env: {wt} worktree, {state} fresh per-run state dir, {tmp} the run's TMPDIR, {logs} the",
    "gate's log dir, {home} $HOME, {sha}, {old_brain} the old-brain build (see builds.old-brain)."
  ],
  "version": 1,
  "port_range": [18700, 18799],
  "builds": {
    "brain":     {"cwd": "root",   "cmd": "cargo build --release", "timeout": 3600, "artifact": "root/target/release/yggdrasil"},
    "net":       {"cwd": "trunk",  "cmd": "cargo build --release", "timeout": 3600, "artifact": "trunk/target/release/bifrost-net"},
    "app":       {"cwd": "branch", "cmd": "npm run build", "timeout": 2400, "artifact": "branch/.next/BUILD_ID",
                  "restore": ["branch/package.json", "branch/package-lock.json"],
                  "_restore": "the prebuild (scripts/sync-version.sh) stamps git describe into both; put back so the tree stays clean"},
    "net-root":  {"cwd": "trunk",  "cmd": "cargo build --release --no-default-features --target-dir target/root", "timeout": 3600,
                  "artifact": "trunk/target/root/release/bifrost-net"},
    "old-brain": {"commit": "2044afb1", "cwd": "root", "cmd": "cargo build --release", "timeout": 3600,
                  "artifact": "root/target/release/yggdrasil",
                  "_doc": "the OLDER brain root-behind/root-home-layout test against: the code of release 20261123-2004-2044afb1, built from git in ~/.cache/trunk-v1/old-brain/<commit> (never read from the live release folder)"}
  },
  "parsers": {
    "cargo":      {"sum": ["test result: \\w+\\. (?P<pass>\\d+) passed; (?P<fail>\\d+) failed; (?P<skip>\\d+) ignored"]},
    "node-test":  {"sum": ["^(?:# |ℹ )pass (?P<pass>\\d+)$", "^(?:# |ℹ )fail (?P<fail>\\d+)$", "^(?:# |ℹ )skipped (?P<skip>\\d+)$"]},
    "playwright": {"sum": ["^\\s+(?P<pass>\\d+) passed", "^\\s+(?P<fail>\\d+) failed", "^\\s+(?P<skip>\\d+) skipped", "^\\s+(?P<pass>\\d+) flaky"]},
    "ok-lines":   {"count": {"pass": "^ok\\s", "fail": "^FAIL\\b"}},
    "pass-lines": {"count": {"pass": "^PASS\\s", "fail": "^FAIL\\s", "skip": "^SKIP\\s"}},
    "step-table": {"count": {"pass": "^\\s{0,4}\\S{1,12}\\s+PASS\\s", "fail": "^\\s{0,4}\\S{1,12}\\s+(?:FAIL|RED)\\s", "skip": "^\\s{0,4}\\S{1,12}\\s+SKIP\\s"}},
    "obs":        {"count": {"pass": "^\\s+\\[PASS\\]", "fail": "^\\s+\\[FAIL\\]"}},
    "rehearsal":  {"raw": true, "count": {"pass": "^\u001b\\[32mPASS\u001b\\[0m", "fail": "^\u001b\\[31mFAIL\u001b\\[0m"}},
    "msm-rows":   {"count": {"pass": "^\\S{1,12}\\s+PASS\\s", "fail": "^\\S{1,12}\\s+(?:FAIL|PART|NO)\\s"}},
    "hsim":       {"count": {"pass": "\\bRESULT PASS\\b", "fail": "\\bRESULT FAIL\\b"}}
  },
